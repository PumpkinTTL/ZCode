# 自有端点参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
# 不设置时源码默认端点已指向 polaris.bitlesu.com（见 packages/shared/src/zcodeEndpoint.ts）。
ZCODE_BASE_URL=https://polaris.bitlesu.com
BIGMODEL_API_BASE_URL=https://polaris.bitlesu.com
ZAI_OAUTH_ORIGIN=https://polaris.bitlesu.com
ZAI_BUSINESS_BASE_URL=https://polaris.bitlesu.com
# 公开 OAuth client id，不是 secret。
ZAI_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg
ZCODE_CDN_BASE_URL=https://polaris.bitlesu.com

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
ZCODE_CONVERSATION_SHARE_WEB_URL=https://polaris.bitlesu.com/cn/share
# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://polaris.bitlesu.com/zcode/electron/releases/3.14.0

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
